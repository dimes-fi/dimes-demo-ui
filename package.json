    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.102.3",
    "@turnkey/react-wallet-kit": "^2.4.1",
    "@turnkey/viem": "^0.14.37",
    "permissionless": "^0.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vaul": "^1.1.2",
    "viem": "^2.55.19",
    "wagmi": "^2.19.5",
    "zustand": "^5.0.15"
